# Optional server-managed fallback. Leave blank to configure keys in the web UI.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Optional: persist web-entered keys using AES-256-GCM. Generate with:
# openssl rand -hex 32
# Store this secret in Codespaces/deployment secrets, never in source control.
SCENECRAFT_KEY_ENCRYPTION_KEY=
# Optional encrypted vault location (default: .scenecraft/keys.json).
SCENECRAFT_KEY_STORE_PATH=

# Defaults; per-browser session settings can override these.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
PORT=3000
